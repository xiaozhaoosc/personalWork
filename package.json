{
  "name": "personal-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先的 WorkBuddy 个人效率驾驶舱",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c blue,green \"vite\" \"npm run server\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
